#!/usr/bin/env bash
# vc-agent — CLI wrapper for voice-code tmux agent operations.
# All tmux logic is in voice-code.agent-cli (Clojure). This script handles
# argument parsing only.

set -euo pipefail

VC_PROJECT_DIR="${VC_PROJECT_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
VC_BACKEND_DIR="$VC_PROJECT_DIR/backend"

# Implementer-mode prefix: prepend to prompt when workdir is ~/assist
IMPL_PREFIX="${IMPL_PREFIX:-}"

_clj_x() {
  cd "$VC_BACKEND_DIR" && clojure -X:agent "$@"
}

_canonicalize_dir() {
  cd "$1" 2>/dev/null && pwd || echo "$1"
}

_escape_str() {
  printf '%s' "$1" | sed 's/"/\\"/g'
}

# --- Recipe REST API helpers ---------------------------------------------
# The recipe commands curl the running backend (no new JVM). Backend
# discovery: port from config.edn (or $VC_BACKEND_PORT, or 8080), API key
# from ~/.untethered/api-key, host always localhost.

_read_backend_port() {
  local config="$VC_BACKEND_DIR/resources/config.edn"
  local port=""
  if [[ -f "$config" ]]; then
    port=$(grep -o ':port[[:space:]]*[0-9]*' "$config" | head -1 | grep -o '[0-9]*')
  fi
  echo "${port:-${VC_BACKEND_PORT:-8080}}"
}

_read_api_key() {
  cat "${VC_API_KEY_FILE:-$HOME/.untethered/api-key}"
}

_recipe_base_url() {
  echo "http://localhost:$(_read_backend_port)/api/recipes"
}

# Build the JSON request body for POST /api/recipes/start. python3's
# json.dumps handles escaping of arbitrary context text safely. Empty
# string args are omitted so the backend applies its own defaults.
# Args: recipe_id working_directory session_id provider context
_recipe_start_body() {
  python3 -c '
import json, sys
d = {"recipe_id": sys.argv[1]}
if sys.argv[2]: d["working_directory"] = sys.argv[2]
if sys.argv[3]: d["session_id"] = sys.argv[3]
if sys.argv[4]: d["provider"] = sys.argv[4]
if sys.argv[5]: d["context"] = sys.argv[5]
print(json.dumps(d))
' "$1" "$2" "$3" "$4" "$5"
}

usage() {
  cat >&2 <<'EOF'
Usage: vc-agent <command> [args]

Commands:
  start <name> [-d dir] [--model M] [--session-id UUID] [--provider P] <prompt|-f file>
  stop <name>
  nudge <name> <message|-f file>
  resume <name-or-uuid> [-d workdir] [--provider P]
  list
  status <name>
  wait <name> [--timeout SECS] [--poll SECS] [--idle-polls N]
  capture <name> [lines]
  session-id <name>
  attach <name>
  recipe <command> [args]   (start | list | status; run 'recipe' for details)
EOF
  exit 1
}

recipe_usage() {
  cat >&2 <<'EOF'
Usage: vc-agent recipe <command> [args]

Commands:
  start <recipe-id> [-d dir] [--session-id UUID] [--provider P] [--context TEXT] [--context-file PATH]
  list
  status <session-id>

Examples:
  vc-agent recipe start implement-and-review-all -d /path/to/project
  vc-agent recipe start document-design -d /path --context "WebSocket rate limiter"
  vc-agent recipe start document-design -d /path --context-file /tmp/brief.md
  vc-agent recipe start break-down-tasks --session-id <uuid>
  vc-agent recipe status <session-id>
  vc-agent recipe list
EOF
  exit 1
}

cmd_start() {
  local name="${1:?'name required'}"; shift
  local workdir="$(pwd)" provider="claude" prompt="" model="" session_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d)           workdir="$2"; shift 2 ;;
      --model)      model="$2"; shift 2 ;;
      --session-id) session_id="$2"; shift 2 ;;
      --provider)   provider="$2"; shift 2 ;;
      -f)           prompt="$(cat "$2")"; shift 2 ;;
      *)            prompt="$1"; shift ;;
    esac
  done

  # Implementer-mode prefix injection
  if [[ -n "$IMPL_PREFIX" ]] && \
     [[ "$(_canonicalize_dir "$workdir")" == "$(_canonicalize_dir "$HOME/assist")" ]]; then
    prompt="${IMPL_PREFIX}${prompt}"
  fi

  local args=(voice-code.agent-cli/start
    :name "\"$(_escape_str "$name")\"")
  [[ -n "$workdir" ]] && args+=(:workdir "\"$(_escape_str "$workdir")\"")
  [[ -n "$provider" ]] && args+=(:provider "\"$(_escape_str "$provider")\"")
  [[ -n "$prompt" ]] && args+=(:prompt "\"$(_escape_str "$prompt")\"")
  [[ -n "$model" ]] && args+=(:model "\"$(_escape_str "$model")\"")
  [[ -n "$session_id" ]] && args+=(:session-id "\"$(_escape_str "$session_id")\"")

  _clj_x "${args[@]}"
}

cmd_stop() {
  local id="${1:?'name or uuid required'}"
  _clj_x voice-code.agent-cli/stop :id "\"$(_escape_str "$id")\""
}

cmd_nudge() {
  local id="${1:?'name or uuid required'}"; shift
  local message=""
  if [[ "$1" == "-f" ]]; then
    message="$(cat "$2")"
  else
    message="$*"
  fi
  _clj_x voice-code.agent-cli/nudge \
    :id "\"$(_escape_str "$id")\"" \
    :message "\"$(_escape_str "$message")\""
}

cmd_resume() {
  local id="${1:?'name or uuid required'}"; shift
  local workdir="" provider=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d)         workdir="$2"; shift 2 ;;
      --provider) provider="$2"; shift 2 ;;
      *)          shift ;;
    esac
  done
  local args=(voice-code.agent-cli/resume :id "\"$(_escape_str "$id")\"")
  [[ -n "$workdir" ]] && args+=(:workdir "\"$(_escape_str "$workdir")\"")
  [[ -n "$provider" ]] && args+=(:provider "\"$(_escape_str "$provider")\"")
  _clj_x "${args[@]}"
}

cmd_list() {
  _clj_x voice-code.agent-cli/list-agents :_ '""'
}

cmd_status() {
  local id="${1:?'name or uuid required'}"
  _clj_x voice-code.agent-cli/status :id "\"$(_escape_str "$id")\""
}

# Block until the agent's turn completes, it stalls on a permission prompt,
# or its pane disappears. Prints one JSON line; exit 0 on a definitive
# outcome, 2 on timeout, 1 on no-such-agent.
cmd_wait() {
  local id="${1:?'name or uuid required'}"; shift || true
  local timeout="" poll="" idle_polls=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout)    timeout="$2"; shift 2 ;;
      --poll)       poll="$2"; shift 2 ;;
      --idle-polls) idle_polls="$2"; shift 2 ;;
      *)            shift ;;
    esac
  done
  local args=(voice-code.agent-cli/wait :id "\"$(_escape_str "$id")\"")
  [[ -n "$timeout" ]] && args+=(:timeout "$timeout")
  [[ -n "$poll" ]] && args+=(:poll "$poll")
  [[ -n "$idle_polls" ]] && args+=(:idle-polls "$idle_polls")
  _clj_x "${args[@]}"
}

cmd_capture() {
  local id="${1:?'name or uuid required'}"
  local lines="${2:-}"
  local args=(voice-code.agent-cli/capture :id "\"$(_escape_str "$id")\"")
  [[ -n "$lines" ]] && args+=(:lines "$lines")
  _clj_x "${args[@]}"
}

cmd_session_id() {
  local id="${1:?'name or uuid required'}"
  _clj_x voice-code.agent-cli/session-id :id "\"$(_escape_str "$id")\""
}

cmd_attach() {
  local id="${1:?'name or uuid required'}"
  local match
  match=$(tmux list-windows -a -F '#{session_name}:#{window_name}' 2>/dev/null \
    | grep -m1 ":${id}") || { echo "No window matching: $id" >&2; exit 1; }
  local session="${match%%:*}" window="${match#*:}"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "=${session}" \; select-window -t "=${session}:=${window}"
  else
    tmux attach-session -t "=${session}" \; select-window -t "=${session}:=${window}"
  fi
}

cmd_recipe_start() {
  local recipe_id="${1:?'recipe_id required'}"; shift
  local workdir="" session_id="" provider="" context=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d)             workdir="$2"; shift 2 ;;
      --session-id)   session_id="$2"; shift 2 ;;
      --provider)     provider="$2"; shift 2 ;;
      --context)      context="$2"; shift 2 ;;
      --context-file) context="$(cat "$2")"; shift 2 ;;
      *)              shift ;;
    esac
  done

  # Default the working directory to $PWD only when starting a NEW session
  # (no --session-id). When resuming an existing session, leave it blank so
  # the backend falls back to the session's stored workdir rather than
  # whatever directory the agent happens to run this command from. An
  # explicit -d always wins.
  if [[ -z "$workdir" && -z "$session_id" ]]; then
    workdir="$(pwd)"
  fi

  local body
  body=$(_recipe_start_body "$recipe_id" "$workdir" "$session_id" "$provider" "$context")

  curl -s -X POST "$(_recipe_base_url)/start" \
    -H "Authorization: Bearer $(_read_api_key)" \
    -H "Content-Type: application/json" \
    -d "$body"
}

cmd_recipe_list() {
  curl -s "$(_recipe_base_url)" \
    -H "Authorization: Bearer $(_read_api_key)"
}

cmd_recipe_status() {
  local session_id="${1:?'session_id required'}"
  curl -s "$(_recipe_base_url)/status/$session_id" \
    -H "Authorization: Bearer $(_read_api_key)"
}

cmd_recipe() {
  local sub="${1:-}"
  [[ -z "$sub" ]] && recipe_usage
  shift
  case "$sub" in
    start)          cmd_recipe_start "$@" ;;
    list)           cmd_recipe_list ;;
    status)         cmd_recipe_status "$@" ;;
    help|--help|-h) recipe_usage ;;
    *) echo "Unknown recipe command: $sub" >&2; recipe_usage ;;
  esac
}

main() {
  local cmd="${1:-}"
  [[ -z "$cmd" ]] && usage
  shift
  case "$cmd" in
    start)      cmd_start "$@" ;;
    stop)       cmd_stop "$@" ;;
    nudge)      cmd_nudge "$@" ;;
    resume)     cmd_resume "$@" ;;
    list)       cmd_list ;;
    status)     cmd_status "$@" ;;
    wait)       cmd_wait "$@" ;;
    capture)    cmd_capture "$@" ;;
    session-id) cmd_session_id "$@" ;;
    attach)     cmd_attach "$@" ;;
    recipe)     cmd_recipe "$@" ;;
    help|--help|-h) usage ;;
    *) echo "Unknown command: $cmd" >&2; usage ;;
  esac
}

# Run main only when executed directly, not when sourced (e.g. by tests).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
